
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is an admin
    function isAdmin(userId) {
      return exists(/databases/$(database)/documents/roles_admin/$(userId));
    }

    // Helper function to check if a user is a cashier
    function isCashier(userId) {
      let userRole = get(/databases/$(database)/documents/users/$(userId)).data.role;
      return userRole == 'cashier';
    }

    // Admins can read everything
    match /{document=**} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }
    
    // Users Collection
    match /users/{userId} {
      // Any authenticated user can create their own user document (on signup)
      allow create: if request.auth != null && request.auth.uid == userId;
      // Users can read their own profile, admins can read any profile
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin(request.auth.uid));
      // Users can update their own username
      allow update: if request.auth != null && request.auth.uid == userId && request.resource.data.keys().hasOnly(['username']);
    }

    // Admin Roles Collection
    match /roles_admin/{userId} {
      // NO ONE can write to this collection from the client-side.
      // This prevents users from making themselves admins.
      // Admin roles must be assigned manually through the Firebase Console.
      allow write: if false;
      allow read: if request.auth != null && isAdmin(request.auth.uid);
    }

    // Clients Collection
    match /clients/{clientId} {
      // Cashiers and Admins can create new clients
      allow create: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
      // Cashiers and Admins can read client data
      allow read: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
      // Cashiers and Admins can update client status
      allow update: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
    }

    // Loans Collection
    match /loans/{loanId} {
      // Cashiers and Admins can create loans, but only if they set themselves as the cashierId
      allow create: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid)) && request.resource.data.cashierId == request.auth.uid;
      // Cashiers and Admins can read loan data
      allow read: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
       // Cashiers and Admins can update loans (e.g., for payments)
      allow update: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
    }

    // Payments Collection
    match /payments/{paymentId} {
       // Cashiers and Admins can create payments, but only if they set themselves as the cashierId
      allow create: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid)) && request.resource.data.cashierId == request.auth.uid;
      // Cashiers and Admins can read payment data
      allow read: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
    }
    
    // Expenses Collection
    match /expenses/{expenseId} {
       // Cashiers and Admins can create expenses, but only if they set themselves as the cashierId
      allow create: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid)) && request.resource.data.cashierId == request.auth.uid;
       // Cashiers and Admins can read expense data
      allow read: if request.auth != null && (isCashier(request.auth.uid) || isAdmin(request.auth.uid));
    }
    
    // Cash Flow & Performance are Admin-only collections
    match /cash_flow/{cashFlowId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }
     match /cashier_performance/{perfId} {
      allow read, write: if request.auth != null && isAdmin(request.auth.uid);
    }
  }
}
